{
  "info": {
    "name": "THAI Please — Functional API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo-only operations. Real money and live ThaiD are not connected."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "boardIndex",
      "value": "0"
    },
    {
      "key": "rewardId",
      "value": ""
    },
    {
      "key": "redemptionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create demo account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/demo-login",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Demo login succeeds', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.collectionVariables.set('accessToken', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Current stored Bingo board",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/quests/active-board",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('25 stored cells', () => pm.expect(pm.response.json().data.currentBoard.cells).to.have.lengthOf(25));",
              "pm.collectionVariables.set('boardIndex', pm.response.json().data.currentBoard.boardIndex);"
            ]
          }
        }
      ]
    },
    {
      "name": "Participating demo shops",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/transactions/shops",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Record demo payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/transactions/pay",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"shopId\": \"1\", \"amount\": 50, \"requestId\": \"{{requestId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Charities with aggregate totals",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/charities",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Record demo donation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/charities/donate",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"charityId\": \"1\", \"amount\": 20, \"requestId\": \"{{requestId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "My donation history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/charities/my-donations",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Claim a completed line (409 until a line is complete)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/quests/claim",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"boardIndex\": \"{{boardIndex}}\", \"mode\": \"AUTO_MAX_TOKEN\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Accept claimed board (409 until claimed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/quests/accept",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"boardIndex\": \"{{boardIndex}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reward catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rewards",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Redeem reward (requires enough tokens)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rewards/redeem",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"rewardId\": \"2\", \"requestId\": \"{{requestId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Buy demo lucky tickets",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rewards/lucky-draw",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketsCount\": 3,\n  \"requestId\": \"{{requestId}}\",\n  \"rewardId\": \"{{rewardId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Flat pricing: token cost = ticketsCount × reward.token_cost, no bulk discount. ticketsCount is an integer 1–100. Choose rewardId from GET /rewards prizes; prizeValue is a declared demo value, not a market quote."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "My durable reward ownership",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rewards/my-items",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "My token ledger",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rewards/my-history",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "My owned rewards (compatibility route)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rewards/my-redemptions",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Returns the same flat owned-item contract as GET /rewards/my-items."
      }
    },
    {
      "name": "Use owned demo coupon",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rewards/use-voucher",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"redemptionId\": \"{{redemptionId}}\"\n}"
        },
        "description": "Own COUPON/DISCOUNT only. AVAILABLE becomes USED without a second token debit. Repeated calls return the same USED item; another owner gets 404; expired coupon gets 409."
      }
    },
    {
      "name": "Add 500 test tokens (demo tools only)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rewards/demo-faucet",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{$guid}}\"\n}"
        },
        "description": "Fixed 500-token test credit. Requires authenticated account and enabled demo tools. Reuse requestId to retry without double credit; arbitrary amount/userId are ignored."
      }
    },
    {
      "name": "Donation dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/charities/dashboard",
        "description": "All-time aggregate totals by foundation category, including closed foundations. No donor identities are returned. Monetary values are THB from recorded simulated donations."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dashboard succeeds', () => pm.response.to.have.status(200));",
              "const report = pm.response.json().data;",
              "pm.test('Four categories reconcile with the summary', () => { pm.expect(report.categories).to.have.lengthOf(4); pm.expect(report.categories.reduce((n,c)=>n+c.donationCount,0)).to.eql(report.summary.donationCount); pm.expect(Math.round(report.categories.reduce((n,c)=>n+c.totalAmount,0)*100)).to.eql(Math.round(report.summary.totalAmount*100)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Pay with discount coupon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/transactions/pay",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shopId\": \"{{shopId}}\",\n  \"amount\": 100,\n  \"couponRedemptionId\": \"{{redemptionId}}\",\n  \"requestId\": \"{{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Optional couponRedemptionId must be an owned, available and unexpired payment-discount voucher. amount is the gross merchandise amount. Apply discount before co-pay. Response originalAmount - discountAmount = totalAmount = userAmount + governmentAmount. Coupon USED and payment are committed atomically. Replaying the same requestId and payload returns the same payment."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment succeeds',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "const p=pm.response.json().data;",
              "pm.test('Discount and funding reconcile',()=>{pm.expect(Math.round((p.originalAmount-p.discountAmount)*100)).to.eql(Math.round(p.totalAmount*100));pm.expect(Math.round((p.userAmount+p.governmentAmount)*100)).to.eql(Math.round(p.totalAmount*100));});"
            ]
          }
        }
      ]
    }
  ]
}
