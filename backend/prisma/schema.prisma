generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model badges {
  badge_id       BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  badge_code     String             @unique(map: "uq_badges_code") @db.VarChar(60)
  badge_name     String             @db.VarChar(150)
  badge_level    badges_badge_level
  metric_code    String             @db.VarChar(80)
  required_count Decimal            @db.Decimal(14, 2)
  description    String?            @db.VarChar(1000)
  is_active      Boolean            @default(true)
  created_at     DateTime           @default(now())
  user_badges    user_badges[]

  @@index([metric_code, badge_level], map: "idx_badges_metric_level")
}

model campaign_daily_usage {
  campaign_id               BigInt    @db.UnsignedBigInt
  usage_date                DateTime  @db.Date
  government_subsidy_amount Decimal   @default(0.00) @db.Decimal(18, 2)
  transaction_count         BigInt    @default(0) @db.UnsignedBigInt
  updated_at                DateTime  @default(now())
  campaigns                 campaigns @relation(fields: [campaign_id], references: [campaign_id], onUpdate: Restrict, map: "fk_campaign_daily_usage_campaign")

  @@id([campaign_id, usage_date])
}

model campaign_user_daily_usage {
  campaign_id               BigInt    @db.UnsignedBigInt
  user_id                   BigInt    @db.UnsignedBigInt
  usage_date                DateTime  @db.Date
  government_subsidy_amount Decimal   @default(0.00) @db.Decimal(18, 2)
  transaction_count         BigInt    @default(0) @db.UnsignedBigInt
  updated_at                DateTime  @default(now())
  campaigns                 campaigns @relation(fields: [campaign_id], references: [campaign_id], onUpdate: Restrict, map: "fk_campaign_user_daily_usage_campaign")
  users                     users     @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_campaign_user_daily_usage_user")

  @@id([campaign_id, user_id, usage_date])
  @@index([user_id, usage_date], map: "idx_campaign_user_daily_usage_user_date")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model campaigns {
  campaign_id               BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  campaign_name             String                      @db.VarChar(200)
  description               String?                     @db.Text
  copay_rate                Decimal                     @default(0.6000) @db.Decimal(5, 4)
  user_daily_quota          Decimal                     @default(150.00) @db.Decimal(14, 2)
  user_total_quota          Decimal                     @default(3000.00) @db.Decimal(14, 2)
  daily_budget              Decimal?                    @db.Decimal(16, 2)
  total_budget              Decimal?                    @db.Decimal(18, 2)
  starts_at                 DateTime
  ends_at                   DateTime
  status                    campaigns_status            @default(DRAFT)
  created_by_user_id        BigInt?                     @db.UnsignedBigInt
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @default(now())
  campaign_daily_usage      campaign_daily_usage[]
  campaign_user_daily_usage campaign_user_daily_usage[]
  users                     users?                      @relation(fields: [created_by_user_id], references: [user_id], onUpdate: Restrict, map: "fk_campaigns_created_by")
  payment_qrs               payment_qrs[]
  quests                    quests[]
  transactions              transactions[]
  wallets                   wallets[]

  @@index([created_by_user_id], map: "fk_campaigns_created_by")
  @@index([status, starts_at, ends_at], map: "idx_campaigns_status_dates")
}

model categories {
  category_id               BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  category_name             String                      @unique(map: "uq_categories_name") @db.VarChar(100)
  description               String?                     @db.VarChar(500)
  is_active                 Boolean                     @default(true)
  created_at                DateTime                    @default(now())
  merchant_categories       merchant_categories[]
  user_category_preferences user_category_preferences[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model daily_social_impact {
  metric_date                   DateTime @db.Date
  province_code                 String   @default("ALL") @db.VarChar(10)
  new_customers_count           BigInt   @default(0) @db.UnsignedBigInt
  successful_referrals_count    BigInt   @default(0) @db.UnsignedBigInt
  benefited_merchants_count     BigInt   @default(0) @db.UnsignedBigInt
  transaction_count             BigInt   @default(0) @db.UnsignedBigInt
  total_spending_amount         Decimal  @default(0.00) @db.Decimal(18, 2)
  government_subsidy_amount     Decimal  @default(0.00) @db.Decimal(18, 2)
  referral_recommended_spending Decimal  @default(0.00) @db.Decimal(18, 2)
  updated_at                    DateTime @default(now())

  @@id([metric_date, province_code])
  @@index([province_code, metric_date], map: "idx_daily_social_impact_province_date")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model external_identities {
  external_identity_id  BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  user_id               BigInt                       @db.UnsignedBigInt
  provider              external_identities_provider
  provider_subject_hash String                       @db.Char(64)
  linked_at             DateTime                     @default(now())
  users                 users                        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_external_identities_user")

  @@unique([provider, provider_subject_hash], map: "uq_external_provider_subject")
  @@index([user_id], map: "idx_external_identities_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model fraud_checks {
  fraud_check_id     BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  transaction_id     BigInt                @db.UnsignedBigInt
  user_latitude      Decimal?              @db.Decimal(10, 7)
  user_longitude     Decimal?              @db.Decimal(10, 7)
  merchant_latitude  Decimal?              @db.Decimal(10, 7)
  merchant_longitude Decimal?              @db.Decimal(10, 7)
  distance_meters    Decimal?              @db.Decimal(12, 2)
  decision           fraud_checks_decision @default(PENDING_REVIEW)
  reason_code        String?               @db.VarChar(80)
  reason_detail      String?               @db.VarChar(1000)
  checked_by_user_id BigInt?               @db.UnsignedBigInt
  checked_at         DateTime              @default(now())
  users              users?                @relation(fields: [checked_by_user_id], references: [user_id], onUpdate: Restrict, map: "fk_fraud_checks_checked_by")
  transactions       transactions          @relation(fields: [transaction_id], references: [transaction_id], onUpdate: Restrict, map: "fk_fraud_checks_transaction")

  @@index([checked_by_user_id], map: "fk_fraud_checks_checked_by")
  @@index([decision, checked_at], map: "idx_fraud_checks_decision")
  @@index([transaction_id, checked_at], map: "idx_fraud_checks_transaction")
}

model merchant_approval_history {
  approval_history_id BigInt                                     @id @default(autoincrement()) @db.UnsignedBigInt
  merchant_id         BigInt                                     @db.UnsignedBigInt
  action_by_user_id   BigInt?                                    @db.UnsignedBigInt
  previous_status     merchant_approval_history_previous_status?
  new_status          merchant_approval_history_new_status
  note                String?                                    @db.VarChar(1000)
  created_at          DateTime                                   @default(now())
  users               users?                                     @relation(fields: [action_by_user_id], references: [user_id], onUpdate: Restrict, map: "fk_merchant_approval_history_actor")
  merchants           merchants                                  @relation(fields: [merchant_id], references: [merchant_id], onUpdate: Restrict, map: "fk_merchant_approval_history_merchant")

  @@index([action_by_user_id], map: "fk_merchant_approval_history_actor")
  @@index([merchant_id, created_at], map: "idx_merchant_approval_history_merchant_date")
}

model merchant_categories {
  merchant_id BigInt     @db.UnsignedBigInt
  category_id BigInt     @db.UnsignedBigInt
  categories  categories @relation(fields: [category_id], references: [category_id], onUpdate: Restrict, map: "fk_merchant_categories_category")
  merchants   merchants  @relation(fields: [merchant_id], references: [merchant_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_merchant_categories_merchant")

  @@id([merchant_id, category_id])
  @@index([category_id], map: "idx_merchant_categories_category")
}

model merchant_users {
  merchant_id   BigInt                       @db.UnsignedBigInt
  user_id       BigInt                       @db.UnsignedBigInt
  merchant_role merchant_users_merchant_role @default(STAFF)
  is_primary    Boolean                      @default(false)
  added_at      DateTime                     @default(now())
  merchants     merchants                    @relation(fields: [merchant_id], references: [merchant_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_merchant_users_merchant")
  users         users                        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_merchant_users_user")

  @@id([merchant_id, user_id])
  @@index([user_id], map: "idx_merchant_users_user")
}

model merchants {
  merchant_id               BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  tax_id                    String?                     @unique(map: "uq_merchants_tax_id") @db.VarChar(30)
  shop_name                 String                      @db.VarChar(200)
  description               String?                     @db.Text
  phone_number              String?                     @db.VarChar(30)
  address_line              String?                     @db.VarChar(500)
  province_code             String?                     @db.VarChar(10)
  district                  String?                     @db.VarChar(100)
  subdistrict               String?                     @db.VarChar(100)
  postal_code               String?                     @db.VarChar(20)
  latitude                  Decimal?                    @db.Decimal(10, 7)
  longitude                 Decimal?                    @db.Decimal(10, 7)
  digital_credit_score      Decimal?                    @db.Decimal(7, 2)
  status                    merchants_status            @default(PENDING)
  submitted_at              DateTime                    @default(now())
  approved_by_user_id       BigInt?                     @db.UnsignedBigInt
  approved_at               DateTime?
  rejection_reason          String?                     @db.VarChar(1000)
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @default(now())
  merchant_approval_history merchant_approval_history[]
  merchant_categories       merchant_categories[]
  merchant_users            merchant_users[]
  users                     users?                      @relation(fields: [approved_by_user_id], references: [user_id], onUpdate: Restrict, map: "fk_merchants_approved_by")
  payment_qrs               payment_qrs[]
  recommendation_logs       recommendation_logs[]
  referrals                 referrals[]
  reviews                   reviews[]
  transactions              transactions[]

  @@index([approved_by_user_id], map: "fk_merchants_approved_by")
  @@index([latitude, longitude], map: "idx_merchants_location")
  @@index([province_code], map: "idx_merchants_province")
  @@index([shop_name], map: "idx_merchants_shop_name")
  @@index([status], map: "idx_merchants_status")
}

model payment_qrs {
  payment_qr_id      BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  qr_reference       String             @unique(map: "uq_payment_qrs_reference") @db.VarChar(100)
  merchant_id        BigInt             @db.UnsignedBigInt
  campaign_id        BigInt             @db.UnsignedBigInt
  created_by_user_id BigInt?            @db.UnsignedBigInt
  amount             Decimal            @db.Decimal(16, 2)
  currency           String             @default("THB") @db.Char(3)
  status             payment_qrs_status @default(CREATED)
  expires_at         DateTime
  created_at         DateTime           @default(now())
  updated_at         DateTime           @default(now())
  campaigns          campaigns          @relation(fields: [campaign_id], references: [campaign_id], onUpdate: Restrict, map: "fk_payment_qrs_campaign")
  users              users?             @relation(fields: [created_by_user_id], references: [user_id], onUpdate: Restrict, map: "fk_payment_qrs_created_by")
  merchants          merchants          @relation(fields: [merchant_id], references: [merchant_id], onUpdate: Restrict, map: "fk_payment_qrs_merchant")
  transactions       transactions?

  @@index([campaign_id], map: "fk_payment_qrs_campaign")
  @@index([created_by_user_id], map: "fk_payment_qrs_created_by")
  @@index([status, expires_at], map: "idx_payment_qrs_expiry")
  @@index([merchant_id, status], map: "idx_payment_qrs_merchant_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model quests {
  quest_id           BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  campaign_id        BigInt            @db.UnsignedBigInt
  reward_id          BigInt?           @db.UnsignedBigInt
  quest_name         String            @db.VarChar(200)
  description        String?           @db.Text
  quest_type         quests_quest_type
  target_value       Decimal           @default(1.00) @db.Decimal(14, 2)
  condition_json     String?           @db.LongText
  starts_at          DateTime?
  ends_at            DateTime?
  status             quests_status     @default(DRAFT)
  created_by_user_id BigInt?           @db.UnsignedBigInt
  created_at         DateTime          @default(now())
  updated_at         DateTime          @default(now())
  campaigns          campaigns         @relation(fields: [campaign_id], references: [campaign_id], onUpdate: Restrict, map: "fk_quests_campaign")
  users              users?            @relation(fields: [created_by_user_id], references: [user_id], onUpdate: Restrict, map: "fk_quests_created_by")
  rewards            rewards?          @relation(fields: [reward_id], references: [reward_id], onUpdate: Restrict, map: "fk_quests_reward")
  user_quests        user_quests[]
  user_rewards       user_rewards[]

  @@index([created_by_user_id], map: "fk_quests_created_by")
  @@index([reward_id], map: "fk_quests_reward")
  @@index([campaign_id, status], map: "idx_quests_campaign_status")
  @@index([quest_type, status], map: "idx_quests_type_status")
}

model recommendation_logs {
  recommendation_id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                  BigInt        @db.UnsignedBigInt
  merchant_id              BigInt        @db.UnsignedBigInt
  user_latitude            Decimal?      @db.Decimal(10, 7)
  user_longitude           Decimal?      @db.Decimal(10, 7)
  recommendation_score     Decimal       @db.Decimal(12, 6)
  position_rank            Int?          @db.UnsignedSmallInt
  algorithm_version        String?       @db.VarChar(50)
  is_clicked               Boolean       @default(false)
  clicked_at               DateTime?
  converted_transaction_id BigInt?       @unique(map: "uq_recommendation_conversion_transaction") @db.UnsignedBigInt
  is_converted             Boolean?
  shown_at                 DateTime      @default(now())
  merchants                merchants     @relation(fields: [merchant_id], references: [merchant_id], onUpdate: Restrict, map: "fk_recommendation_logs_merchant")
  transactions             transactions? @relation(fields: [converted_transaction_id], references: [transaction_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_logs_transaction")
  users                    users         @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_recommendation_logs_user")

  @@index([is_clicked, shown_at], map: "idx_recommendation_click")
  @@index([merchant_id, shown_at], map: "idx_recommendation_merchant_date")
  @@index([user_id, shown_at], map: "idx_recommendation_user_date")
}

model referrals {
  referral_id                             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  inviter_user_id                         BigInt           @db.UnsignedBigInt
  referred_user_id                        BigInt?          @unique(map: "uq_referrals_referred_user") @db.UnsignedBigInt
  merchant_id                             BigInt?          @db.UnsignedBigInt
  referral_code                           String           @unique(map: "uq_referrals_code") @db.VarChar(32)
  discount_amount                         Decimal          @default(30.00) @db.Decimal(14, 2)
  status                                  referrals_status @default(PENDING)
  converted_transaction_id                BigInt?          @unique(map: "uq_referrals_converted_transaction") @db.UnsignedBigInt
  created_at                              DateTime         @default(now())
  accepted_at                             DateTime?
  converted_at                            DateTime?
  expires_at                              DateTime?
  users_referrals_inviter_user_idTousers  users            @relation("referrals_inviter_user_idTousers", fields: [inviter_user_id], references: [user_id], onUpdate: Restrict, map: "fk_referrals_inviter")
  merchants                               merchants?       @relation(fields: [merchant_id], references: [merchant_id], onUpdate: Restrict, map: "fk_referrals_merchant")
  users_referrals_referred_user_idTousers users?           @relation("referrals_referred_user_idTousers", fields: [referred_user_id], references: [user_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_referrals_referred_user")
  transactions                            transactions?    @relation(fields: [converted_transaction_id], references: [transaction_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_referrals_transaction")
  user_rewards                            user_rewards[]

  @@index([inviter_user_id, status, created_at], map: "idx_referrals_inviter_status")
  @@index([merchant_id], map: "idx_referrals_merchant")
}

model reviews {
  review_id                         BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  transaction_id                    BigInt         @unique(map: "uq_reviews_transaction") @db.UnsignedBigInt
  user_id                           BigInt         @db.UnsignedBigInt
  merchant_id                       BigInt         @db.UnsignedBigInt
  rating_stars                      Int            @db.UnsignedTinyInt
  review_text                       String?        @db.Text
  status                            reviews_status @default(VISIBLE)
  moderated_by                      BigInt?        @db.UnsignedBigInt
  moderated_at                      DateTime?
  created_at                        DateTime       @default(now())
  updated_at                        DateTime       @default(now())
  merchants                         merchants      @relation(fields: [merchant_id], references: [merchant_id], onUpdate: Restrict, map: "fk_reviews_merchant")
  users_reviews_moderated_byTousers users?         @relation("reviews_moderated_byTousers", fields: [moderated_by], references: [user_id], onUpdate: Restrict, map: "fk_reviews_moderated_by")
  transactions                      transactions   @relation(fields: [transaction_id], references: [transaction_id], onUpdate: Restrict, map: "fk_reviews_transaction")
  users_reviews_user_idTousers      users          @relation("reviews_user_idTousers", fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_reviews_user")

  @@index([moderated_by], map: "fk_reviews_moderated_by")
  @@index([merchant_id, status, created_at], map: "idx_reviews_merchant_status_date")
  @@index([user_id, created_at], map: "idx_reviews_user_date")
}

model rewards {
  reward_id      BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  reward_name    String                 @db.VarChar(200)
  reward_type    rewards_reward_type
  discount_type  rewards_discount_type?
  discount_value Decimal?               @db.Decimal(14, 2)
  points_value   BigInt?                @db.UnsignedBigInt
  valid_days     Int                    @default(30) @db.UnsignedInt
  min_purchase   Decimal                @default(0.00) @db.Decimal(14, 2)
  status         rewards_status         @default(ACTIVE)
  created_at     DateTime               @default(now())
  updated_at     DateTime               @default(now())
  quests         quests[]
  user_rewards   user_rewards[]

  @@index([status, reward_type], map: "idx_rewards_status_type")
}

model roles {
  role_id    BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  role_code  String       @unique(map: "uq_roles_role_code") @db.VarChar(40)
  role_name  String       @db.VarChar(100)
  created_at DateTime     @default(now())
  user_roles user_roles[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model transactions {
  transaction_id      BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  idempotency_key     String?               @unique(map: "uq_transactions_idempotency_key") @db.VarChar(100)
  user_id             BigInt                @db.UnsignedBigInt
  merchant_id         BigInt                @db.UnsignedBigInt
  campaign_id         BigInt                @db.UnsignedBigInt
  payment_qr_id       BigInt                @unique(map: "uq_transactions_payment_qr") @db.UnsignedBigInt
  wallet_id           BigInt?               @db.UnsignedBigInt
  subtotal_amount     Decimal               @db.Decimal(16, 2)
  discount_amount     Decimal               @default(0.00) @db.Decimal(16, 2)
  total_amount        Decimal               @db.Decimal(16, 2)
  copay_rate_snapshot Decimal               @default(0.6000) @db.Decimal(5, 4)
  gov_copay_amount    Decimal               @default(0.00) @db.Decimal(16, 2)
  citizen_paid_amount Decimal               @default(0.00) @db.Decimal(16, 2)
  currency            String                @default("THB") @db.Char(3)
  status              transactions_status   @default(PENDING)
  failure_reason      String?               @db.VarChar(1000)
  created_at          DateTime              @default(now())
  completed_at        DateTime?
  updated_at          DateTime              @default(now())
  fraud_checks        fraud_checks[]
  recommendation_logs recommendation_logs?
  referrals           referrals?
  reviews             reviews?
  campaigns           campaigns             @relation(fields: [campaign_id], references: [campaign_id], onUpdate: Restrict, map: "fk_transactions_campaign")
  merchants           merchants             @relation(fields: [merchant_id], references: [merchant_id], onUpdate: Restrict, map: "fk_transactions_merchant")
  payment_qrs         payment_qrs           @relation(fields: [payment_qr_id], references: [payment_qr_id], onUpdate: Restrict, map: "fk_transactions_payment_qr")
  users               users                 @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_transactions_user")
  wallets             wallets?              @relation(fields: [wallet_id], references: [wallet_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_transactions_wallet")
  user_rewards        user_rewards[]
  wallet_transactions wallet_transactions[]

  @@index([wallet_id], map: "fk_transactions_wallet")
  @@index([campaign_id, status, created_at], map: "idx_transactions_campaign_status")
  @@index([merchant_id, created_at], map: "idx_transactions_merchant_date")
  @@index([status, created_at], map: "idx_transactions_status_date")
  @@index([user_id, created_at], map: "idx_transactions_user_date")
}

model user_badges {
  user_badge_id     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt   @db.UnsignedBigInt
  badge_id          BigInt   @db.UnsignedBigInt
  earned_at         DateTime @default(now())
  progress_at_award Decimal? @db.Decimal(14, 2)
  badges            badges   @relation(fields: [badge_id], references: [badge_id], onUpdate: Restrict, map: "fk_user_badges_badge")
  users             users    @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_user_badges_user")

  @@unique([user_id, badge_id], map: "uq_user_badge")
  @@index([badge_id], map: "idx_user_badges_badge")
}

model user_category_preferences {
  preference_id     BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt     @db.UnsignedBigInt
  category_id       BigInt     @db.UnsignedBigInt
  preference_weight Decimal    @default(1.0000) @db.Decimal(5, 4)
  updated_at        DateTime   @default(now())
  categories        categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_category_preferences_category")
  users             users      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_category_preferences_user")

  @@unique([user_id, category_id], map: "uq_user_category_preference")
  @@index([category_id], map: "idx_user_category_preferences_category")
