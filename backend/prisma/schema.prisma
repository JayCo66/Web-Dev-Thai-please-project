generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model rewards {
  reward_id   BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name        String              @db.VarChar(200)
  description String?             @db.Text
  image_url   String?             @db.VarChar(500)
  reward_type rewards_reward_type @default(COUPON)
  token_cost  Int                 @default(50)
  is_active   Boolean             @default(true)
  created_at  DateTime            @default(now())
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model transactions {
  transaction_id    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt              @db.UnsignedBigInt
  shop_id           BigInt              @db.UnsignedBigInt
  total_amount      Decimal             @db.Decimal(12, 2)
  user_amount       Decimal             @db.Decimal(12, 2)
  government_amount Decimal             @db.Decimal(12, 2)
  status            transactions_status @default(COMPLETED)
  paid_at           DateTime            @default(now())
  shops             shops               @relation(fields: [shop_id], references: [shop_id], onUpdate: Restrict, map: "fk_trans_shop")
  users             users               @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_transactions_user")

  @@index([shop_id], map: "idx_trans_shop")
  @@index([user_id], map: "idx_trans_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_quests {
  user_quest_id      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  board_id           BigInt               @db.UnsignedBigInt
  quest_id           BigInt               @db.UnsignedBigInt
  position           Int                  @db.UnsignedTinyInt
  status             user_quests_status   @default(IN_PROGRESS)
  progress           Int                  @default(0)
  target_value       Int                  @default(1)
  token_reward       Int                  @default(10)
  completed_at       DateTime?
  donations          donations[]
  token_transactions token_transactions[]
  bingo_boards       bingo_boards         @relation(fields: [board_id], references: [board_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_quests_board")
  quests             bingo_quests         @relation(fields: [quest_id], references: [quest_id], onUpdate: Restrict, map: "fk_user_quests_quest")

  @@unique([board_id, position], map: "uq_board_position")
  @@index([board_id], map: "idx_user_quests_board")
  @@index([quest_id], map: "idx_user_quests_quest")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  user_id            BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  name               String               @db.VarChar(200)
  thai_id_hash       String?              @unique(map: "uq_users_thai_id_hash") @db.Char(64)
  thai_id_encrypted  String?              @db.VarChar(255)
  email              String?              @unique(map: "uq_users_email") @db.VarChar(254)
  phone_number       String?              @unique(map: "uq_users_phone") @db.VarChar(30)
  password_hash      String?              @db.VarChar(255)
  pin_hash           String?              @db.VarChar(255)
  role               users_role           @default(CITIZEN)
  province_code      String?              @default("BKK") @db.VarChar(10)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @default(now())
  bingo_boards       bingo_boards[]
  donations          donations[]
  shops              shops[]
  token_transactions token_transactions[]
  transactions       transactions[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bingo_boards {
  board_id           BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  user_id            BigInt                        @db.UnsignedBigInt
  board_size         Int                           @default(5) @db.TinyInt
  status             bingo_boards_status           @default(ACTIVE)
  generated_by_ai    Boolean                       @default(true)
  line_select_mode   bingo_boards_line_select_mode @default(AUTO_MAX_TOKEN)
  selected_line      String?                       @db.VarChar(50)
  started_at         DateTime                      @default(now())
  completed_at       DateTime?
  accepted_at        DateTime?
  users              users                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_boards_user")
  token_transactions token_transactions[]
  user_quests        user_quests[]

  @@index([user_id], map: "idx_boards_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bingo_quests {
  quest_id          BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  title             String                         @db.VarChar(200)
  description       String?                        @db.Text
  category          String                         @db.VarChar(100)
  shop_category     String?                        @db.VarChar(100)
  verification_type bingo_quests_verification_type @default(AUTO_TRANSACTION)
  target_min        Int                            @default(1)
  target_max        Int                            @default(1)
  token_weight      Int                            @default(10)
  is_active         Boolean                        @default(true)
  created_at        DateTime                       @default(now())
  user_quests       user_quests[]
}

model charities {
  charity_id  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  name        String                @db.VarChar(200)
  tax_id      String                @unique(map: "uq_charities_tax_id") @db.VarChar(30)
  description String?               @db.Text
  impact_type charities_impact_type
  is_active   Boolean               @default(true)
  created_at  DateTime              @default(now())
  donations   donations[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model donations {
  donation_id   BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  user_quest_id BigInt?      @db.UnsignedBigInt
  charity_id    BigInt       @db.UnsignedBigInt
  user_id       BigInt       @db.UnsignedBigInt
  amount        Decimal      @db.Decimal(12, 2)
  edonation_ref String?      @db.VarChar(100)
  donated_at    DateTime     @default(now())
  charities     charities    @relation(fields: [charity_id], references: [charity_id], onUpdate: Restrict, map: "fk_donations_charity")
  user_quests   user_quests? @relation(fields: [user_quest_id], references: [user_quest_id], onUpdate: Restrict, map: "fk_donations_quest")
  users         users        @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_donations_user")

  @@index([charity_id], map: "idx_donations_charity")
  @@index([user_id], map: "idx_donations_user")
  @@index([user_quest_id], map: "idx_donations_user_quest")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model shops {
  shop_id       BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  shop_name     String         @db.VarChar(200)
  category      String         @db.VarChar(100)
  address       String?        @db.Text
  owner_user_id BigInt?        @db.UnsignedBigInt
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  users         users?         @relation(fields: [owner_user_id], references: [user_id], onUpdate: Restrict, map: "fk_shops_owner")
  transactions  transactions[]

  @@index([owner_user_id], map: "idx_shops_owner")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model token_transactions {
  token_transaction_id BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt                  @db.UnsignedBigInt
  amount               Int
  type                 token_transactions_type
  board_id             BigInt?                 @db.UnsignedBigInt
  user_quest_id        BigInt?                 @db.UnsignedBigInt
  created_at           DateTime                @default(now())
  bingo_boards         bingo_boards?           @relation(fields: [board_id], references: [board_id], onUpdate: Restrict, map: "fk_tokens_board")
  user_quests          user_quests?            @relation(fields: [user_quest_id], references: [user_quest_id], onUpdate: Restrict, map: "fk_tokens_quest")
  users                users                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_tokens_user")

  @@index([board_id], map: "idx_tokens_board")
  @@index([user_quest_id], map: "idx_tokens_quest")
  @@index([user_id], map: "idx_tokens_user")
}

enum bingo_boards_status {
  ACTIVE
  COMPLETED
  ACCEPTED
  EXPIRED
}

enum token_transactions_type {
  EARN_CELL
  EARN_LINE
  REDEEM_REWARD
  EXPIRED
}

enum charities_impact_type {
  EDUCATION
  ENVIRONMENT
  COMMUNITY
  HEALTHCARE
}

enum rewards_reward_type {
  COUPON
  DISCOUNT
  PHYSICAL
  LUCKY_DRAW
}

enum user_quests_status {
  IN_PROGRESS
  COMPLETED
  CLAIMED
}

enum bingo_boards_line_select_mode {
  AUTO_MAX_TOKEN
  MANUAL
}

enum bingo_quests_verification_type {
  AUTO_TRANSACTION
  DONATION
  MANUAL
}

enum transactions_status {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum users_role {
  CITIZEN
  MERCHANT
  ADMIN
  GOV_EXECUTIVE
}
